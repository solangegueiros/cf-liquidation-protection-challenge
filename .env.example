### REQUIRED — SENSITIVE INFORMATION. DO NOT SHARE OR COMMIT .env           ###
###############################################################################

# Hardhat deployment / CRE workflow signing key
# Also used as the private key for the liquidation protection workflow (inside TEE)
CRE_ETH_PRIVATE_KEY=

# Etherscan API key (for contract verification)
ETHERSCAN_API_KEY=

# Sepolia RPC URL (optional override — defaults to public node)
SEPOLIA_RPC_URL=

###############################################################################
# CRE LIQUIDATION PROTECTION WORKFLOW — PRIVATE POLICY PARAMETERS             #
# These are your confidential strategy inputs. They stay inside the TEE.      #
###############################################################################

# Minimum health factor that triggers intervention (stored ×100, matches contract)
# Example: 108 = HF 1.08 — intervene when HF drops to or below 1.08
CRE_LIQUIDATION_MIN_HF_TRIGGER_VAR=108

# Target health factor to restore after intervention (stored ×100)
# Example: 115 = HF 1.15
CRE_LIQUIDATION_TARGET_HF_VAR=115

# Maximum percentage of current debt to repay in one intervention (integer 0–100)
# Example: 15 = repay at most 15% of outstanding vUSD debt
CRE_LIQUIDATION_MAX_REPAY_PCT_VAR=15

# Maximum vETH collateral to deposit in one intervention (raw units, 100 = 1.00 vETH)
# Example: 300 = deposit at most 3.00 vETH
CRE_LIQUIDATION_MAX_DEPOSIT_UNITS_VAR=300
